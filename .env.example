# PostgreSQL (matches docker-compose.yml)
KORA_DATABASE_URL=postgresql+psycopg://kora:kora@localhost:5432/kora

# Development convenience: create tables at API startup.
# Replace with Alembic before production.
KORA_AUTO_CREATE_SCHEMA=true

