# PostgreSQL (matches docker-compose.yml)
KORA_DATABASE_URL=postgresql+psycopg://kora:kora@localhost:5432/kora

# Production-safe default: apply migrations explicitly.
#   cd backend && alembic upgrade head
# Set true only for throwaway local databases.
KORA_AUTO_CREATE_SCHEMA=false

# Optional source configuration
# KORA_MAILTO=you@example.org
# OPENALEX_API_KEY=
# KORA_CACHE_DIR=.cache
